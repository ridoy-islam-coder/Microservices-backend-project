{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES6"],
    "allowJs": true,
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "sourceMap": true,
    "types": ["node", "express"],
    "noImplicitAny": false,
    
    /* ❌ পুরানো "baseUrl" লাইনটি এখান থেকে ডিলিট করে দেওয়া হয়েছে */

    /* ✅ সঠিকভাবে এভাবে paths সেট করুন */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}

